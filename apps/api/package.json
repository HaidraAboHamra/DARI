{
  "name": "@dari/api",
  "version": "0.1.0",
  "private": true,
  "description": "Dari City OS API: modular monolith (HTTP + background worker).",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --env-file-if-exists=.env --watch -r @swc-node/register src/main.ts",
    "dev:worker": "node --env-file-if-exists=.env --watch -r @swc-node/register src/worker.ts",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env -r @swc-node/register src/infrastructure/database/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env -r @swc-node/register src/infrastructure/database/seed/seed.ts"
  },
  "dependencies": {
    "@dari/contracts": "workspace:*",
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@nestjs/common": "^11.2.11",
    "@nestjs/core": "^11.2.11",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-fastify": "^11.2.11",
    "bullmq": "^5.81.5",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "ioredis": "^5.11.1",
    "nestjs-pino": "^4.6.1",
    "pg": "^8.23.1",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^11.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dari/tsconfig": "workspace:*",
    "@nestjs/testing": "^11.2.11",
    "@swc-node/register": "^1.10.10",
    "@swc/core": "^1.16.22",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.4",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.0.0",
    "typescript": "5.9.3",
    "unplugin-swc": "^1.5.5",
    "vitest": "^3.2.7"
  }
}
