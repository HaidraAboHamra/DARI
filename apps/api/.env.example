NODE_ENV=development
PORT=4000
LOG_LEVEL=info
LOG_PRETTY=true
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dari
# Optional read replica used for search, listings and insights.
DATABASE_REPLICA_URL=
DB_POOL_MAX=20
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
PUBLIC_API_URL=http://localhost:4000

# Development only: fixed OTP code. Refused when NODE_ENV=production.
OTP_DEV_CODE=123456
# OTP delivery: log (dev only) | http | whatsapp
SMS_PROVIDER=log
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_SENDER=DARI
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_OTP_TEMPLATE=dari_otp

# Media: local (single node) | s3 (S3 / Cloudflare R2 / MinIO)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_PUBLIC_URL=

# City AI assistant: without a key, a deterministic rules engine answers.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_HOURLY_LIMIT=30

# Protect /metrics for Prometheus (optional).
METRICS_TOKEN=
