NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dari
# Optional read replica used for search, listings and insights.
DATABASE_REPLICA_URL=
DB_POOL_MAX=20
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3000
# Development only: fixed OTP code. Refused when NODE_ENV=production.
OTP_DEV_CODE=123456
LOG_PRETTY=true
