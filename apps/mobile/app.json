{
  "expo": {
    "name": "داري",
    "slug": "dari",
    "scheme": "dari",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F6F0E0",
    "primaryColor": "#C9A24B",
    "ios": {
      "bundleIdentifier": "sy.dari.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "لمسح رموز QR للتذاكر وإرفاق الصور",
        "NSPhotoLibraryUsageDescription": "لإرفاق صور المنتجات والعقارات"
      }
    },
    "android": {
      "package": "sy.dari.app",
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1424"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-status-bar",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C9A24B"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "لإرفاق صور المنتجات والعقارات"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-blank.png",
          "imageWidth": 8,
          "resizeMode": "contain",
          "backgroundColor": "#0B1424"
        }
      ]
    ],
    "extra": {
      "supportsRTL": true,
      "forcesRTL": true
    },
    "experiments": {
      "typedRoutes": false
    },
    "icon": "./assets/icon.png"
  }
}
